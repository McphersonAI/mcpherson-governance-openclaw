{
  "name": "@mcphersonai/mcpherson-governance-openclaw",
  "version": "0.7.4",
  "description": "Observa SHADOW governance evidence plugin for OpenClaw",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "observa-pair": "./observa-pair.mjs",
    "observa-openclaw-ctl": "./plugins/openclaw-connector/connector-ctl.mjs",
    "observa": "./observa.mjs"
  },
  "files": [
    "plugins/",
    "pairing/",
    "observa-pair.mjs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "LICENSE-CLARIFICATION-v0.7.4.md",
    "CANDIDATE-PROVENANCE.json",
    "openclaw.plugin.json",
    "cli/",
    "observa.mjs",
    "observa-pair-legacy.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.mjs'",
    "verify:license": "node scripts/verify-license.mjs",
    "verify:release": "node scripts/verify-license.mjs --artifact"
  },
  "openclaw": {
    "extensions": [
      "./plugins/openclaw-connector/plugin.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.8.2"
    },
    "build": {
      "openclawVersion": "2026.8.2",
      "shadowMode": "SHADOW",
      "authority": "NONE",
      "enforcement": "OFF",
      "active": false,
      "receiptMode": "POST_HOOK"
    }
  }
}
