{
  "name": "@mcphersonai/mcpherson-governance-openclaw",
  "version": "0.5.0",
  "description": "Shadow-only OpenClaw plugin that observes configured tool activity, sends metadata-minimized governance requests, and records local attempt and completion receipts. It does not block or alter tool execution.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "McPherson AI LLC",
  "homepage": "https://mcphersonai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/McphersonAI/mcpherson-governance-openclaw.git"
  },
  "bugs": {
    "url": "https://github.com/McphersonAI/mcpherson-governance-openclaw/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "governance",
    "observability",
    "shadow-mode",
    "audit",
    "receipts"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./connector/plugin.mjs",
  "exports": {
    ".": "./connector/plugin.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "mcpherson-connector-ctl": "connector/connector-ctl.mjs"
  },
  "files": [
    "openclaw.plugin.json",
    "connector/",
    "examples/",
    "tests/",
    "scripts/verify-package.mjs",
    "scripts/build-release-artifacts.mjs",
    "scripts/run-public-tests.mjs",
    "NOTICE",
    "CONNECTOR-FILES.sha256",
    "SEALED-CONNECTOR-FILES.sha256",
    "RELEASE-CHECKSUMS.sha256",
    "CHANGELOG.md",
    "INSTALL.md",
    "LIFECYCLE.md",
    "LIMITATIONS.md",
    "PRIVACY.md",
    "SECURITY.md",
    "SUPPORT.md",
    "VERIFY.md"
  ],
  "scripts": {
    "test": "node --test tests/public-distribution.test.mjs tests/public-runtime.test.mjs && node scripts/verify-package.mjs",
    "test:public": "node scripts/run-public-tests.mjs",
    "verify": "node scripts/verify-package.mjs"
  },
  "openclaw": {
    "extensions": [
      "./connector/plugin.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.6.5"
    },
    "build": {
      "openclawVersion": "2026.6.5",
      "openclawCommit": "5181e4f",
      "receiptMode": "POST_HOOK"
    }
  }
}
