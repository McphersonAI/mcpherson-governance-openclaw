{
  "name": "mcpherson-governance-connector",
  "version": "0.5.1",
  "description": "Shadow-only OpenClaw connector for McPherson Governance. Observes configured tool activity and records local receipts; does not block or alter tool execution.",
  "type": "module",
  "main": "plugin.mjs",
  "license": "Apache-2.0",
  "author": "McPherson AI LLC",
  "homepage": "https://mcphersonai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/McphersonAI/mcpherson-governance-openclaw.git",
    "directory": "connector"
  },
  "bugs": {
    "url": "https://github.com/McphersonAI/mcpherson-governance-openclaw/issues"
  },
  "bin": {
    "connector-ctl": "connector-ctl.mjs"
  },
  "scripts": {
    "test": "node ../scripts/verify-package.mjs"
  },
  "openclaw": {
    "extensions": [
      "./plugin.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.6.5"
    },
    "build": {
      "openclawVersion": "2026.6.5",
      "openclawCommit": "5181e4f",
      "receiptMode": "POST_HOOK"
    }
  }
}
