{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mcpherson.ai/governance/diagnostics/mcpherson-governance-advisory-classification-suggestion-v1.schema.json",
  "title": "McPherson Governance v0.6 advisory classification suggestion set",
  "description": "Provider-neutral advisory suggestion fixture format. model_invoked_in_build is fixed false: no external or local model inference occurs in v0.6, and a suggestion can never confirm a classification, change a trusted effect set, or make a mapping active.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suggestion_set_id",
    "model_invoked_in_build",
    "provider_neutral",
    "suggestions"
  ],
  "properties": {
    "schema": {
      "const": "mcpherson-governance-advisory-classification-suggestion/v1"
    },
    "suggestion_set_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,96}$"
    },
    "model_invoked_in_build": {
      "const": false
    },
    "provider_neutral": {
      "const": true
    },
    "note": {
      "type": "string",
      "maxLength": 512
    },
    "suggestions": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "suggested_effects",
          "suggestion_source",
          "rationale"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^mgc-[a-f0-9]{24}$"
          },
          "suggested_effects": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "enum": [
                "READ",
                "WRITE",
                "SEND",
                "DELETE",
                "EXECUTE",
                "UNKNOWN"
              ]
            }
          },
          "suggestion_source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,96}$"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
