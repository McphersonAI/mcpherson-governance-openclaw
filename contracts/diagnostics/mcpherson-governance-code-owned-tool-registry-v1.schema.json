{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mcpherson.ai/governance/diagnostics/mcpherson-governance-code-owned-tool-registry-v1.schema.json",
  "title": "McPherson Governance v0.6 code-owned tool registry",
  "description": "Input format for committed_registry_v1 discovery. A document matching this schema is still untrusted until registry-binding verification passes: repository identity, trusted repository-relative path, and exact raw-byte hash pin, plus per-entry cross-checks against the authoritative code-owned classifier. Effects must equal the documented conformance mapping for the entry's action class.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_id",
    "code_owned",
    "registry"
  ],
  "properties": {
    "schema": {
      "const": "mcpherson-governance-code-owned-tool-registry/v1"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,96}$"
    },
    "code_owned": {
      "const": true
    },
    "registry": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "action_class",
          "effects",
          "evidence"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,96}$"
          },
          "action_class": {
            "enum": [
              "read_only_internal",
              "reversible_internal_write",
              "file_modification",
              "command_execution",
              "configuration_modification",
              "service_gateway_control",
              "external_outbound",
              "credential_secret_access",
              "destructive_irreversible",
              "unknown"
            ]
          },
          "effects": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "enum": [
                "READ",
                "WRITE",
                "SEND",
                "DELETE",
                "EXECUTE",
                "UNKNOWN"
              ]
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "rationale": {
            "type": "string",
            "maxLength": 512
          },
          "reversibility": {
            "enum": [
              "reversible",
              "irreversible",
              "unknown"
            ]
          },
          "target_resource_class": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "data_classes": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "side_effects": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "completion_evidence": {
            "enum": [
              "POST_HOOK",
              "ATTEMPT_ONLY",
              "UNKNOWN"
            ]
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    }
  }
}
