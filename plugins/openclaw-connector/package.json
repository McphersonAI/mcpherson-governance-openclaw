{
  "name": "mcpherson-governance-connector",
  "version": "0.8.0",
  "description": "Observa native evidence adapter for OpenClaw 2026.10.9; enforcement disabled by default, optional isolated V7 synthetic binding.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "plugin.mjs",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "scripts": {},
  "openclaw": {
    "extensions": [
      "./plugin.mjs"
    ],
    "compat": {
      "pluginApi": "2026.10.9"
    },
    "build": {
      "openclawVersion": "2026.10.9",
      "shadowMode": "SHADOW",
      "authority": "NONE",
      "enforcement": "OFF",
      "active": false,
      "receiptMode": "POST_HOOK"
    }
  }
}
