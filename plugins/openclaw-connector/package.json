{
  "name": "mcpherson-governance-connector",
  "version": "0.7.4",
  "description": "Internal Observa SHADOW plugin entrypoint for OpenClaw",
  "type": "module",
  "main": "plugin.mjs",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {},
  "openclaw": {
    "extensions": [
      "./plugin.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.8.2"
    },
    "build": {
      "openclawVersion": "2026.8.2",
      "shadowMode": "SHADOW",
      "authority": "NONE",
      "enforcement": "OFF",
      "active": false,
      "receiptMode": "POST_HOOK"
    }
  }
}
