{
  "name": "@mcphersonai/mcpherson-governance-openclaw",
  "version": "0.6.3-beta.6",
  "description": "Account-free OpenClaw plugin for local agent and tool discovery, non-authoritative AutoMap proposals, and a local Governability Diagnosis. Shadow-only: it does not block or alter tool execution.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "McPherson AI LLC",
  "homepage": "https://mcphersonai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/McphersonAI/mcpherson-governance-openclaw.git"
  },
  "bugs": {
    "url": "https://github.com/McphersonAI/mcpherson-governance-openclaw/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "governance",
    "observability",
    "shadow-mode",
    "audit",
    "receipts",
    "diagnostics"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./plugins/openclaw-connector/plugin.mjs",
  "exports": {
    ".": "./plugins/openclaw-connector/plugin.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "mcpherson-connector-ctl": "plugins/openclaw-connector/connector-ctl.mjs",
    "observa-pair": "observa-pair.mjs"
  },
  "files": [
    "openclaw.plugin.json",
    "plugins/",
    "packages/",
    "contracts/",
    "scripts/",
    "examples/",
    "tests/",
    "NOTICE",
    "V6-PACKAGE-MANIFEST.json",
    "PACKAGE-FILES.sha256",
    "RELEASE-PROVENANCE.json",
    "CHANGELOG.md",
    "COMPATIBILITY.md",
    "INSTALL.md",
    "LIFECYCLE.md",
    "LIMITATIONS.md",
    "PRIVACY.md",
    "SECURITY.md",
    "SUPPORT.md",
    "VERIFY.md",
    "observa-pair.mjs",
    "CANDIDATE-PROVENANCE.json"
  ],
  "scripts": {
    "test": "node --test tests/public-package.test.mjs tests/hook-adapter.test.mjs tests/redaction.test.mjs tests/release-manifests.test.mjs tests/fresh-pair-observation.test.mjs",
    "test:connector": "node --test tests/hook-adapter.test.mjs",
    "test:regression": "node --test tests/redaction.test.mjs tests/release-manifests.test.mjs",
    "test:all": "node --test tests/public-package.test.mjs tests/hook-adapter.test.mjs tests/redaction.test.mjs tests/release-manifests.test.mjs tests/fresh-pair-observation.test.mjs",
    "verify": "node scripts/verify-package.mjs",
    "verify:manifests": "node scripts/build-release-manifests.mjs --check"
  },
  "openclaw": {
    "extensions": [
      "./plugins/openclaw-connector/plugin.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.6.5"
    },
    "build": {
      "openclawVersion": "2026.6.33",
      "openclawCommit": "7af0cfc",
      "receiptMode": "POST_HOOK"
    }
  }
}
