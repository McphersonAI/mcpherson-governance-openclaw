{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mcpherson.ai/governance/diagnostics/mcpherson-governance-shadow-receipt-summary-v1.schema.json",
  "title": "McPherson Governance v0.6 shadow receipt summary",
  "description": "Sanitized fixture coverage input. Each entry has a unique receipt_id and one explicit granularity. OPERATION_LEVEL entries require normalized_capability (and may carry capability_id and native_tool_name, which must all be mutually consistent). TOOL_LEVEL entries carry only native_tool_name and make no claim about any individual operation. Consumers strictly reject duplicate receipt IDs, mutually inconsistent identifiers, invalid counts, invalid receipt modes, attempt-only entries with completions, impossible count relationships, and any measurement kind other than FIXTURE. LIVE_SHADOW uses a distinct observer-owned receipt-summary contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_note",
    "sanitization_confirmed",
    "measurement_kind",
    "receipts"
  ],
  "properties": {
    "schema": {
      "const": "mcpherson-governance-shadow-receipt-summary/v1"
    },
    "source_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sanitization_confirmed": {
      "const": true
    },
    "measurement_kind": {
      "const": "FIXTURE"
    },
    "receipts": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt_id",
          "granularity",
          "native_tool_name",
          "attempt_receipts",
          "completion_receipts",
          "receipt_mode"
        ],
        "properties": {
          "receipt_id": {
            "type": "string",
            "pattern": "^rcpt-[A-Za-z0-9._:-]{1,64}$"
          },
          "granularity": {
            "enum": [
              "OPERATION_LEVEL",
              "TOOL_LEVEL"
            ]
          },
          "native_tool_name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,96}$"
          },
          "normalized_capability": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "capability_id": {
            "type": "string",
            "pattern": "^mgc-[a-f0-9]{24}$"
          },
          "attempt_receipts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "completion_receipts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "receipt_mode": {
            "enum": [
              "POST_HOOK",
              "ATTEMPT_ONLY"
            ]
          }
        }
      }
    }
  }
}
